# FAIDA Predict — environment template. Copy to .env and adjust.
# Never commit a real .env.

# Prisma datasource. Local sandbox default is SQLite:
DATABASE_URL="file:./db/custom.db"

# For Vercel + managed Postgres (production path), switch the provider in
# prisma/schema.prisma to "postgresql" and point DATABASE_URL at your database:
# DATABASE_URL="postgresql://user:password@host:5432/faida"

# AI providers are configured at runtime in Settings (stored in the AiProvider
# table, keys masked). No AI keys are read from the environment.
