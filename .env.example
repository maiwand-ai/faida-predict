# FAIDA Predict — environment template. Copy to .env and adjust.
# Never commit a real .env.

# Prisma datasource. Local sandbox default is SQLite:
DATABASE_URL="file:./db/custom.db"

# For Vercel + managed Postgres (production path), switch the provider in
# prisma/schema.prisma to "postgresql" and point DATABASE_URL at your database:
# DATABASE_URL="postgresql://user:password@host:5432/faida"

# AI providers are configured at runtime in Settings (stored in the AiProvider
# table, keys masked). No AI keys are read from the environment.

# Email fan-out for the transactional outbox (S-02/F8). Create a key at
# resend.com/api-keys. Without it, the in-app notification feed still works —
# email is best-effort and per-event status is recorded (SENT/FAILED/NO_KEY).
# RESEND_API_KEY="re_..."
# NOTIFY_EMAIL_FROM="FAIDA Predict <alerts@yourdomain.com>"

# ── Phase 7: gated live automation (B1/B10) ─────────────────────────────────
# All live-money secrets follow the token discipline: injected per-process,
# NEVER stored in the database, never returned by an API, redacted in logs.
# The platform structurally cannot store the signing key (no column exists).

# Self-custody signer key (EIP-712 order signing). Leave unset in paper mode;
# without it the live path signs nothing and refuses honestly.
# POLYMARKET_SIGNER_KEY="0x..."

# Polymarket CLOB L2 credentials (derive via /auth/derive-api-key with the
# signer key; see docs.polymarket.com). Required for the send boundary only.
# POLYMARKET_API_KEY=""
# POLYMARKET_API_SECRET=""
# POLYMARKET_API_PASSPHRASE=""

# THE ARM SWITCH: while unset or != "1", every live order is built, signed and
# audited but NOT sent (DRY_RUN armor). Setting it =1 arms real transmission
# for the small-capital pilot — after consent (C25), pilot caps and counsel
# sign-off. There is no API to set this; it exists only in the environment.
# POLYMARKET_LIVE_WRITE="1"
