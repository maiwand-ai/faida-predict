# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dev.log
server.log
*.tsbuildinfo
next-env.d.ts

# environment — never commit real config
.env
.env.*
!.env.example

# local database (SQLite) — schema lives in prisma/, data does not belong in git
/db

# sandbox / workspace files (not part of the product)
/.zscripts
/Caddyfile
/download
/upload
/examples
/mini-services
/tool-results
# /tests is scratch space — EXCEPT the S-05 conformance fixtures, which are
# recorded evidence and MUST be committed (standing rule §3.4).
/tests/*
!/tests/fixtures
/skills
/scripts/report
/scripts/wireframes
/.serena
/.agentctx
__pycache__/
dev-smoke10.log

# local SQLite database (DATABASE_URL resolves relative to prisma/)
/prisma/db
